# UAT defaults (staging-like, typically points at a real cluster)
#
# Usage:
#   ENVIRONMENT=uat scripts/run-local.sh start
#
# Customize endpoints for your UAT environment.

ENVIRONMENT=uat
PROFILE=live
BIND_ADDRESS=0.0.0.0
NEXT_HOSTNAME=0.0.0.0

ANALYZER_PORT=18081
DASHBOARD_PORT=3003

# REQUIRED for live profile: must be reachable from the analyzer process.
COLLECTOR_URL=http://hetu-collector:8080

# LLM (example: OpenAI-compatible gateway / real provider)
LLM_PROVIDER=openai
LLM_ENDPOINT=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo
LLM_API_KEY=

# If dashboard should bypass proxy and hit analyzer directly from the browser:
# NEXT_PUBLIC_API_URL=http://<analyzer-host>:18081
NEXT_PUBLIC_API_URL=


# Production example (DO NOT COMMIT secrets in prod.env)
#
# Create your own env/prod.env locally or use your secret manager.

ENVIRONMENT=prod
PROFILE=live
BIND_ADDRESS=0.0.0.0
NEXT_HOSTNAME=0.0.0.0

# If running locally (rare), pick non-conflicting ports:
ANALYZER_PORT=18081
DASHBOARD_PORT=3003

COLLECTOR_URL=http://cluster-intel-collector:8080

LLM_PROVIDER=anthropic
LLM_ENDPOINT=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

NEXT_PUBLIC_API_URL=


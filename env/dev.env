# Development defaults (local laptop / LAN demo)
#
# Usage:
#   ENVIRONMENT=dev scripts/run-local.sh start
#
# Note: For the dashboard, prefer leaving NEXT_PUBLIC_API_URL empty so REST
# calls use the built-in Next.js proxy (/api/v1/*) and work from any origin.

ENVIRONMENT=dev
PROFILE=live
BIND_ADDRESS=0.0.0.0
NEXT_HOSTNAME=0.0.0.0
DASHBOARD_MODE=prod

ANALYZER_PORT=18081
DASHBOARD_PORT=3003

# For live profile, point to a reachable collector. The local default
# `http://localhost:18080` matches scripts/run-local.sh's COLLECTOR_PORT —
# start a collector there or override to point at a remote one.
COLLECTOR_URL=http://localhost:18080

# LLM (local Ollama by default)
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3
LLM_API_KEY=

# Dashboard (empty => relative URLs via proxy)
NEXT_PUBLIC_API_URL=


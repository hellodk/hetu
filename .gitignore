# ============================================================================
# K8s Cluster Intelligence Engine — .gitignore
# ============================================================================
# NOTE: node_modules/ and bin/ binaries were committed to history before this
# file was tightened. Run `git rm -r --cached node_modules src/dashboard/node_modules bin`
# to untrack the already-committed files (does NOT delete local copies).
# ============================================================================

# ---- Dependencies ---------------------------------------------------------
node_modules/
venv/
.venv/
vendor/

# ---- Compiled Go binaries -------------------------------------------------
bin/
# Binary produced when `go build` is run in the package directory.
src/collector/cluster-intel-collector
src/collector/collector
src/analyzer/cluster-intel-analyzer
src/analyzer/analyzer
src/collector-lblogs/collector-lblogs
src/collector-podlogs/collector-podlogs
# Backwards-compat: also ignore copies at repo root (old build outputs).
/cluster-intel-collector
/cluster-intel-analyzer
/analyzer
/collector

# Go coverage and profiling output
coverage.out
coverage.html
*.prof
*.pprof

# ---- Next.js / TypeScript -------------------------------------------------
src/dashboard/.next/
src/dashboard/out/
src/dashboard/build/
src/dashboard/next-env.d.ts
src/dashboard/tsconfig.tsbuildinfo
src/dashboard/.turbo/

# ---- Test artifacts -------------------------------------------------------
# Playwright
src/dashboard/playwright-report/
src/dashboard/test-results/
src/dashboard/blob-report/
src/dashboard/playwright/.cache/
# Legacy screenshot harness
test-screenshots/

# ---- Logs & runtime state -------------------------------------------------
*.log
*.log.*
*.pid
/tmp/cluster-intel-logs/

# ---- Local backups / swap files -------------------------------------------
*.bak
*.swp
*.swo
*~
.orig
*.rej

# ---- Environment & secrets ------------------------------------------------
.env
.env.local
.env.*.local
.envrc
secrets.yaml
secrets.yml
*.pem
*.key
# Production overlays are local-only by default.
/values-prod.yaml
env/prod.env
# Kubeconfig files occasionally land in workspaces.
kubeconfig
kubeconfig.yaml
*.kubeconfig

# ---- IDE / editor ---------------------------------------------------------
.cursor/
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# ---- AI tool artifacts ----------------------------------------------------
.aider.*
.claude/
.champ/
.playwright-mcp/

# ---- Personal scratch / session notes ------------------------------------
prompts

# ---- Screenshot artifacts -------------------------------------------------
audit-screenshots/
# Screenshots are generated by Playwright tests and one-off UI verification
# scripts. They are not source code. Committed design work lives as HTML in
# docs/ui-mockups/, not as rendered PNGs.
# Root-level verification screenshots
/*.png
# Dashboard working-directory screenshots (visual-audit writes to test-results/)
src/dashboard/*.png
# Mockup rendered screenshots (HTML mockups are the source of truth)
docs/ui-mockups/**/*.png
# Root-level test-results dir (dashboard one is already covered above)
/test-results/

# ---- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---- Python (scripts may pull in venvs) ----------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Helm / Kustomize build output ---------------------------------------
# NOTE: we DO track the bundled Helm sub-chart tarballs under
# deploy/helm/cluster-intel/charts/ because they're the vendored chart
# dependencies required by `make helm-deploy` — re-adding them means an
# operator doesn't have to run `helm dependency build` first.
charts/*.tgz
!deploy/helm/cluster-intel/charts/*.tgz
helm-rendered.yaml

# ---- Monitoring stack build output ---------------------------------------
manifests/monitoring/generated/

# ---- Benchmark output ----------------------------------------------------
*.bench
benchmark-*.txt

# ---- Recorded demo videos (generated by scripts/record-demo.js) ----------
demo.webm
demo.mp4
*.mov

# ---- Personal session scratch (not intended for git) ---------------------
requests.md

# ---- Secret-bearing local overrides (committed examples are .example) ----
*.local.env
env/*.local.env
*.secret.yaml
*.creds
.envrc

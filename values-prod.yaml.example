# cluster-intel — production example
#
# Copy to values-prod.yaml (DO NOT COMMIT secrets), then:
#   make helm-deploy ENV=prod

cluster:
  id: "prod"
  displayName: "Cluster Intel (prod)"

writeActions:
  enabled: false

exec:
  enabled: false

serviceMonitor:
  enabled: true

networkPolicy:
  enabled: true

monitoring:
  enabled: true

# LLM: avoid hardcoding loopback addresses. Prefer setting an in-cluster
# endpoint (Service DNS) or use an external IP with appropriate NetworkPolicy.
llm:
  provider: "openai"
  endpoint: ""
  model: "gpt-4-turbo"
  apiKeySecret:
    name: ""     # create separately
    key: api-key


apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-tempo
  namespace: ${MONITORING_NAMESPACE}
  labels:
    app.kubernetes.io/part-of: hetu
    app.kubernetes.io/managed-by: kubectl
    app: tempo
    # Picked up by the kube-prometheus-stack Grafana sidecar.
    grafana_datasource: "1"
data:
  tempo-datasource.yaml: |
    apiVersion: 1
    datasources:
      - name: Tempo
        type: tempo
        uid: ${TEMPO_UID}
        access: proxy
        url: ${TEMPO_URL}
        isDefault: false
        editable: true
        jsonData:
          httpMethod: GET
          # Jump from a span to its logs in Loki.
          tracesToLogs:
            datasourceUid: ${LOKI_UID}
            filterBySpanID: true
            filterByTraceID: true
            tags: [service.name]
          # Jump from a span to request/error-rate metrics in Prometheus.
          tracesToMetrics:
            datasourceUid: ${PROMETHEUS_UID}
            spanStartTimeShift: '-1h'
            spanEndTimeShift: '1h'
            queries:
              - name: 'Request rate'
                query: 'sum(rate(cluster_intel_llm_request_total[5m]))'
              - name: 'Error rate'
                query: 'sum(rate(cluster_intel_llm_request_total{status="error"}[5m])) / sum(rate(cluster_intel_llm_request_total[5m]))'
          serviceMap:
            datasourceUid: ${PROMETHEUS_UID}
          search:
            hide: false
          nodeGraph:
            enabled: true
